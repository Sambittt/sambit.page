rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is an authorized administrator
    // Requires verified email and either custom claim 'admin == true' or an authorized Admin UID
    // Hardcoded public email addresses have been removed to protect against phishing/enumeration
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.admin == true ||
          request.auth.uid in [
            'ADMIN_UID_1', // Replace with primary admin Firebase Auth UID
            'ADMIN_UID_2'  // Replace with secondary admin Firebase Auth UID (if applicable)
          ]
        );
    }

    // ── Users Collection (ACCESS REQUESTS + STATUS) ──
    // Enforces server-side privilege separation: normal users cannot grant themselves
    // 'approved' status or 'admin' roles.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['displayName', 'email', 'uid', 'reason', 'stego_reason', 'requestedAt', 'status', 'stego_status']) &&
          (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'not requested']) &&
          (!('stego_status' in request.resource.data) || request.resource.data.stego_status in ['pending', 'not requested']) &&
          (!('role' in request.resource.data))
        )
      );

      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          // Non-admin users cannot touch the 'role' field
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
          // If status is changed, user can only set it to 'pending'
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status == 'pending') &&
          // If stego_status is changed, user can only set it to 'pending'
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stego_status']) || request.resource.data.stego_status == 'pending')
        )
      );

      allow delete: if isAdmin();
    }

    // ── Scan Logs (NetProbe scan history) ──
    match /scan_logs/{logId} {
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'target', 'targetType', 'riskScore', 'points', 'timestamp']) &&
        request.resource.data.target is string && request.resource.data.target.size() <= 255 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 100 &&
        request.resource.data.targetType is string && request.resource.data.targetType.size() <= 32;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── Cloud Shares ──
    // Allow get for individual shared links, but restrict list/collection queries to owner or admin
    match /cloud-shares/{share} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['shareId', 'uid', 'fileName', 'fileSize', 'fileType', 'storagePath', 'downloadURL', 'files', 'expiresAt', 'createdAt']) &&
        request.resource.data.fileName is string && request.resource.data.fileName.size() <= 255 &&
        request.resource.data.fileType is string && request.resource.data.fileType.size() <= 100;
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ── Cloud Visitor Security Logs ──
    // Requires authenticated user or App Check, with strict field and size validation
    match /cloud-visits/{visit} {
      allow create: if (request.auth != null || request.app != null) &&
        request.resource.data.keys().hasOnly([
          'shareId', 'fileName', 'ip', 'city', 'region', 'country', 'countryCode',
          'org', 'userAgent', 'platform', 'language', 'screenRes', 'referrer', 'visitedAt'
        ]) &&
        request.resource.data.shareId is string && request.resource.data.shareId.size() <= 128 &&
        request.resource.data.fileName is string && request.resource.data.fileName.size() <= 255 &&
        request.resource.data.ip is string && request.resource.data.ip.size() <= 64 &&
        request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 512;
      allow read, update, delete: if isAdmin();
    }

    // ── AI Chat History / Analytics ──
    // Requires authenticated user or App Check, with strict field, type, and size limits
    match /ai_chats/{chat} {
      allow create: if (request.auth != null || request.app != null) &&
        request.resource.data.keys().hasOnly(['userName', 'sender', 'message', 'timestamp']) &&
        request.resource.data.userName is string && request.resource.data.userName.size() <= 100 &&
        request.resource.data.sender in ['user', 'bot'] &&
        request.resource.data.message is string && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}
