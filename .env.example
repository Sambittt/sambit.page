# Environment Configuration Example
# Copy to .env for backend/local use (never commit .env to public Git repositories)

# Port for NetProbe backend
PORT=3000

# Optional Server-side Shodan API Key for NetProbe proxy
SHODAN_KEY=your_shodan_api_key_here

# Groq API Key (for LLM chatbot in local dev or backend)
GROQ_API_KEY=your_groq_api_key_here

# ImgBB API Key (for image upload integrations)
IMGBB_API_KEY=your_imgbb_api_key_here
